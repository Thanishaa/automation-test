{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["cypress", "node"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@parabank/types": ["cypress/e2e/parabank.d.ts"],
      "@parabank/*": ["cypress/e2e/*"]
    }
  },
  "include": ["cypress/e2e/**/*.ts", "cypress/e2e/**/*.tsx", "cypress.config.ts"]
}
